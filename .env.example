# Copy to .env and fill in. .env is ignored by git.

# LLM provider: "gemini" (Google AI Studio) or "openai" (any OpenAI-compatible endpoint, e.g. AMD / vLLM)
LLM_PROVIDER=amd
# Gemma 4: free tier ~14.4K requests/day, open-weight (can run on AMD GPUs later)
LLM_MODEL=gemma-4-26b-a4b-it
# tried in order if the main model fails (comma separated)
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Used when LLM_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=

# H&M sales_channel_id treated as the physical store (undocumented in the dataset)
FITPATH_STORE_CHANNEL=1

# models used by the agent, in order (falls back to the next on errors)
AGENT_MODELS=gemini-4-argon,gemini-3.8-flash

# AMD inference API (OpenAI-compatible)
AMD_API_KEY=
AMD_BASE_URL=
AMD_MODEL=DeepSeek-V4-Flash
AMD_FALLBACK_MODELS=Qwen3.8-Flash-Next
